spring:
  application:
    name: opay-backend
  
  datasource:
    url: jdbc:mysql://localhost:3306/OPAY
    username: your-username
    password: your-password
    driver-class-name: com.mysql.cj.jdbc.Driver
  
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect
  
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

server:
  port: 8080
  servlet:
    context-path: /api

jwt:
  secret: your-jwt-secret-key-change-in-production
  access-token-expiration: 3600000 # 1 hour (milliseconds)
  refresh-token-expiration: 604800000 # 7 days (milliseconds)

logging:
  level:
    com.opay: DEBUG
    org.springframework.security: DEBUG

# AWS S3 설정
aws:
  s3:
    region: ap-northeast-2  # 서울 리전
    bucket: your-bucket-name  # 버킷 이름
    access-key: ${AWS_ACCESS_KEY_ID:your-access-key}  # 환경 변수 또는 직접 입력
    secret-key: ${AWS_SECRET_ACCESS_KEY:your-secret-key}  # 환경 변수 또는 직접 입력
    object-lock:
      enabled: false  # 객체 잠금 활성화 여부 (기본값: false)
      mode: GOVERNANCE  # GOVERNANCE (관리자 해제 가능) 또는 COMPLIANCE (해제 불가)
      retention-days: 30  # 보관 기간 (일)
  environment: ${SPRING_PROFILES_ACTIVE:dev}  # 환경 정보 (dev/staging/prod)
